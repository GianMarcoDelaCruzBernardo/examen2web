<%- include('../partials/head', { title: 'Medicamento' }) %>
<% const m = medicamento || {}; const c = categorias || []; const labs = laboratorios || []; const tipos = tiposMed || []; const esp = especialidades || []; %>
<div class="tarjeta formulario">
  <h1><%= m.id ? 'Editar medicamento' : 'Nuevo medicamento' %></h1>
  <form method="post" action="<%= m.id ? '/medicamentos/' + m.id + '/editar' : '/medicamentos' %>">
    <div class="campo">
      <label>Nombre</label>
      <input name="nombre" required value="<%= m.nombre || '' %>">
    </div>
    <div class="dos-col">
      <div class="campo">
        <label>Precio (S/)</label>
        <input name="precio" type="number" step="0.01" min="0" required value="<%= m.precio !== undefined ? m.precio : '' %>">
      </div>
      <div class="campo">
        <label>Stock</label>
        <input name="stock" type="number" min="0" required value="<%= m.stock !== undefined ? m.stock : 0 %>">
      </div>
    </div>
    <div class="campo">
      <label>Categoría</label>
      <select name="categoriaId" required>
        <option value="">-- Selecciona --</option>
        <% c.forEach(function(cat) { %>
          <option value="<%= cat.id %>" <%= m.categoriaId == cat.id ? 'selected' : '' %>><%= cat.nombre %></option>
        <% }) %>
      </select>
    </div>
    <div class="campo">
      <label>Laboratorio</label>
      <select name="laboratorioId">
        <option value="">-- Selecciona --</option>
        <% labs.forEach(function(lab) { %>
          <option value="<%= lab.CodLab %>" <%= m.laboratorioId == lab.CodLab ? 'selected' : '' %>><%= lab.razonSocial %></option>
        <% }) %>
      </select>
    </div>
    <div class="dos-col">
      <div class="campo">
        <label>Tipo de Medicamento</label>
        <select name="tipoMedicId">
          <option value="">-- Selecciona --</option>
          <% tipos.forEach(function(t) { %>
            <option value="<%= t.CodTipoMed %>" <%= m.tipoMedicId == t.CodTipoMed ? 'selected' : '' %>><%= t.descripcion %></option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label>Especialidad</label>
        <select name="especialidadId">
          <option value="">-- Selecciona --</option>
          <% esp.forEach(function(e) { %>
            <option value="<%= e.CodEspec %>" <%= m.especialidadId == e.CodEspec ? 'selected' : '' %>><%= e.descripcionEsp %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="campo">
      <label>Fecha de Vencimiento</label>
      <input name="fecha_vencimiento" type="date" value="<%= m.fecha_vencimiento || '' %>">
    </div>
    <div class="fila-botones">
      <button class="btn" type="submit">Guardar</button>
      <a class="btn btn-sec" href="/medicamentos">Cancelar</a>
    </div>
  </form>
</div>
<%- include('../partials/foot') %>