<%- include('../partials/head', { title: 'Medicamento' }) %>
<% const m = medicamento || {}; const l = listas || {}; %>
<div class="tarjeta formulario">
  <h1><%= m.id ? 'Editar medicamento' : 'Nuevo medicamento' %></h1>
  <form method="post" action="<%= m.id ? '/medicamentos/' + m.id + '/editar' : '/medicamentos' %>">
    <div class="campo">
      <label>Nombre</label>
      <input name="nombre" required value="<%= m.nombre || '' %>">
    </div>
    <div class="dos-col">
      <div class="campo">
        <label>Precio</label>
        <input name="precio" type="number" step="0.01" required value="<%= m.precio || '' %>">
      </div>
      <div class="campo">
        <label>Stock</label>
        <input name="stock" type="number" required value="<%= m.stock || 0 %>">
      </div>
    </div>
    <div class="campo">
      <label>Categoría</label>
      <select name="categoriaId" required>
        <option value="">-- Selecciona --</option>
        <% l.categorias.forEach(c => { %> <option value="<%= c.id %>" <%= m.categoriaId == c.id ? 'selected' : '' %>><%= c.nombre %></option> <% }) %>
      </select>
    </div>
    <div class="campo">
      <label>Laboratorio</label>
      <select name="laboratorioId">
        <option value="">-- Selecciona --</option>
        <% l.laboratorios.forEach(lab => { %> <option value="<%= lab.CodLab %>" <%= m.laboratorioId == lab.CodLab ? 'selected' : '' %>><%= lab.razonSocial %></option> <% }) %>
      </select>
    </div>
    <div class="dos-col">
      <div class="campo">
        <label>Tipo de Medicamento</label>
        <select name="tipoMedicId">
          <option value="">-- Selecciona --</option>
          <% l.tipos.forEach(t => { %> <option value="<%= t.CodTipoMed %>" <%= m.tipoMedicId == t.CodTipoMed ? 'selected' : '' %>><%= t.descripcion %></option> <% }) %>
        </select>
      </div>
      <div class="campo">
        <label>Especialidad</label>
        <select name="especialidadId">
          <option value="">-- Selecciona --</option>
          <% l.especialidades.forEach(e => { %> <option value="<%= e.CodEspec %>" <%= m.especialidadId == e.CodEspec ? 'selected' : '' %>><%= e.descripcionEsp %></option> <% }) %>
        </select>
      </div>
    </div>
    <div class="campo">
      <label>Fecha Vencimiento</label>
      <input name="fecha_vencimiento" type="date" value="<%= m.fecha_vencimiento || '' %>">
    </div>
    <div class="fila-botones">
      <button class="btn" type="submit">Guardar</button>
      <a class="btn btn-sec" href="/medicamentos">Cancelar</a>
    </div>
  </form>
</div>
<%- include('../partials/foot') %>
